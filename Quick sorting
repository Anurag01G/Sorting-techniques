#include<iostream>
using namespace std;

void quicksort(int arr[], int low, int high)
{
    if (low<high)
    {
        int pivot=arr[high];
        int i=low-1;

        for (int j=low;j<high;j++)
        {
            if (arr[j]<pivot)
            {
                i++;
                swap(arr[i],arr[j]);
            }
        }
        swap(arr[i+1],arr[high]);
        int pivotindx=i+1;
        quicksort(arr,low,pivotindx-1);
        quicksort(arr,pivotindx+1,high);
    }
}

int main()
{
    int arr[]={5,2,4,1,3};
    cout<<"Array before sorting : ";
    for(int i=0;i<5;i++)
    {
        cout<<arr[i]<<" ";
    }
    cout<<endl;
    quicksort(arr,0,5);
    cout<<"Array after sorting : ";
    for(int i=0;i<5;i++)
    {
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}
