#include<iostream>
using namespace std;

int main()
{
    int j;
    int arr[] = {5,2,-4,1,3};
    int min = arr[0];
    int mindx = 0;
    cout<<"Array before sorting : ";
    for (int i=0;i<5;i++)
        {
            cout<<arr[i]<<" ";
        }
    for (int i=0;i<5;i++)
        {
            int min = arr[i];
            int mindx = i;
            for (int j=i;j<5;j++)
                {
                    if(arr[j]<min)
                    {
                        min = arr[j];
                        mindx = j;
                    }
                }
            swap(arr[i],arr[mindx]);
        }
    cout<<"\nArray after soritng : ";
    for (int i=0;i<5;i++)
        {
            cout<<arr[i]<<" ";
        }
    
    return 0;
}
