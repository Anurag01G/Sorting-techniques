#include<iostream>
using namespace std;

int main()
{
    int i;
    int arr[]={5,3,4,2,1};
    cout<<"Array before sorting : ";
    for (int i=0;i<5;i++)
    {
        cout<<arr[i]<<" ";
    }
    for (int i=0;i<4;i++)
    {
        int j=i+1;
        while(j>=1 && arr[j]<arr[j-1])
        {
            swap(arr[j],arr[j-1]);
            j--;
        }
    }
    cout<<"\nArray after sorting : ";
    for (int i=0;i<5;i++)
    {
        cout<<arr[i]<<" ";
    }
    return 0;
}
